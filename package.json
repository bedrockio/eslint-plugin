{
  "name": "@bedrockio/eslint-plugin",
  "version": "1.7.0",
  "description": "Common ESLint plugin for Bedrock projects.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "scripts/build",
    "prepublishOnly": "yarn build"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin"
  ],
  "main": "./dist/esm/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/esm/index.js"
    },
    "./resolvers/vite": {
      "import": "./dist/esm/resolvers/vite.js",
      "require": "./dist/esm/resolvers/vite.js"
    }
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.19.1",
    "@eslint/js": "^10.0.1",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-exports": "^1.0.0-beta.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-import-resolver-vite": "^2.2.0",
    "eslint-import-resolver-webpack": "^0.13.11",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-mdx": "^3.8.1",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@bedrockio/prettier-config": "^1.1.1",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "peerDependencies": {
    "eslint": ">=10",
    "typescript": ">=6"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "prettier": "@bedrockio/prettier-config",
  "volta": {
    "node": "24.13.1",
    "yarn": "1.22.22"
  }
}
